IDI_ICON1 ICON "cutline.ico"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION CUTLINE_VERSION_RC
PRODUCTVERSION CUTLINE_VERSION_RC
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Cutline video editor"
            VALUE "FileVersion", CUTLINE_VERSION
            VALUE "InternalName", "Cutline"
            VALUE "OriginalFilename", "Cutline.exe"
            VALUE "ProductName", "Cutline"
            VALUE "ProductVersion", CUTLINE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
